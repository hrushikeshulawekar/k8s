pipeline {
    agent any

    environment {
        IMAGE         = "evil08/cicd-project"
        TAG           = "${BUILD_NUMBER}"
        SERVICE_NAME  = "node-service"
        DEPLOYMENT    = "node-app"
        CONTAINER     = "node-app"
        NAMESPACE     = "default"
        K8S_DIR       = "/var/lib/jenkins/k8s"
        TIMEOUT       = "300s"
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Clone') {
            steps {
                echo "📥 Cloning repository..."
                git branch: 'main', url: 'https://github.com/hrushikeshulawekar/node-demo.git'
            }
        }

        stage('Build Image') {
            steps {
                echo "🔨 Building Docker image ${IMAGE}:${TAG}..."
                sh "docker build -t ${IMAGE}:${TAG} ."
            }
        }

        stage('Push Image') {
            steps {
                echo "📤 Pushing image to Docker Hub..."
                script {
                    docker.withRegistry('https://registry.hub.docker.com', 'dockerhub-creds') {
                        docker.image("${IMAGE}:${TAG}").push()
                        docker.image("${IMAGE}:${TAG}").push('latest')
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {

                    echo "🔍 Verifying kubectl access..."

                    def kubectlCheck = sh(
                        script: "kubectl get nodes --request-timeout=10s",
                        returnStatus: true
                    )

                    if (kubectlCheck != 0) {
                        error("❌ kubectl cannot reach the cluster. Check kubeconfig/RBAC permissions.")
                    }

                    def currentRevision = sh(
                        script: """
                            kubectl get deployment/${env.DEPLOYMENT} \
                                -n ${env.NAMESPACE} \
                                -o jsonpath='{.metadata.annotations.deployment\\.kubernetes\\.io/revision}' \
                                2>/dev/null || echo '0'
                        """,
                        returnStdout: true
                    ).trim().toInteger()

                    echo "📌 Current deployment revision: ${currentRevision}"

                    echo "🖼️ Templating image tag ${IMAGE}:${TAG} into deployment.yaml..."

                    // Patch the image tag into a throwaway copy of the manifest so the
                    // committed deployment.yaml (with :latest) never has to be edited,
                    // and so this single 'apply' is the ONLY mutation per deploy —
                    // keeping the Deployment's revision history one-to-one with builds.
                    sh """
                        sed -E "s#image: ${IMAGE}:.*#image: ${IMAGE}:${TAG}#" \
                            ${env.K8S_DIR}/deployment.yaml > /tmp/deployment-${TAG}.yaml
                    """

                    echo "📦 Applying Kubernetes manifests..."

                    sh """
                        kubectl apply -f /tmp/deployment-${TAG}.yaml -n ${env.NAMESPACE}
                        kubectl apply -f ${env.K8S_DIR}/service.yaml -n ${env.NAMESPACE}
                        kubectl apply -f ${env.K8S_DIR}/hpa.yaml -n ${env.NAMESPACE}
                    """

                    echo "⏳ Waiting for rollout to complete (timeout: ${env.TIMEOUT})..."

                    def rolloutStatus = sh(
                        script: """
                            kubectl rollout status deployment/${env.DEPLOYMENT} \
                                -n ${env.NAMESPACE} \
                                --timeout=${env.TIMEOUT}
                        """,
                        returnStatus: true
                    )

                    if (rolloutStatus != 0) {

                        echo "⚠️ Rollout failed! Attempting rollback..."

                        if (currentRevision > 0) {

                            def undoStatus = sh(
                                script: """
                                    kubectl rollout undo deployment/${env.DEPLOYMENT} \
                                        -n ${env.NAMESPACE}
                                """,
                                returnStatus: true
                            )

                            if (undoStatus != 0) {
                                error("❌ Deployment FAILED. Rollback command failed. Manual intervention required.")
                            }

                            echo "⏳ Waiting for rollback to complete..."

                            def rollbackWait = sh(
                                script: """
                                    kubectl rollout status deployment/${env.DEPLOYMENT} \
                                        -n ${env.NAMESPACE} \
                                        --timeout=${env.TIMEOUT}
                                """,
                                returnStatus: true
                            )

                            if (rollbackWait == 0) {

                                currentBuild.result = 'UNSTABLE'

                                echo """
=========================================================
⚠️ DEPLOYMENT FAILED
✅ AUTOMATIC ROLLBACK SUCCEEDED

Rolled back to revision ${currentRevision}
Application restored to previous version.

Build marked as UNSTABLE.
=========================================================
"""

                                return

                            } else {

                                error("""
❌ Deployment FAILED.
❌ Rollback was attempted but deployment is still unhealthy.
Manual intervention required.
""")
                            }

                        } else {

                            error("""
❌ First deployment FAILED.
No previous revision exists to roll back to.
Manual intervention required.
""")
                        }
                    }

                    echo "✅ Deployment successful!"

                    sh """
                        NODE_PORT=\$(kubectl get svc ${env.SERVICE_NAME} \
                            -n ${env.NAMESPACE} \
                            -o jsonpath='{.spec.ports[0].nodePort}')

                        NODE_IP=\$(kubectl get nodes \
                            -o jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}')

                        echo "🌐 Service is available at http://\$NODE_IP:\$NODE_PORT"
                    """
                }
            }
        }
    }

    post {

        success {
            echo "✅ Pipeline completed successfully! Image: ${IMAGE}:${TAG}"
        }

        unstable {
            echo "⚠️ Deployment failed but automatic rollback succeeded."
        }

        failure {
            echo "❌ Pipeline failed at stage. Check logs above for details."
        }

        always {
            sh "docker rmi ${IMAGE}:${TAG} || true"
            sh "rm -f /tmp/deployment-${TAG}.yaml || true"
            echo "🧹 Cleaned up local Docker image and temp manifest."
        }
    }
}
